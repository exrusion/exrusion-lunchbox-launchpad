pragma solidity ^0.8.24;
interface IPonsV2FeeEscrow{function claim()external returns(uint256);function claimToken(address token)external returns(uint256);}interface IERC20Minimal{function balanceOf(address account)external view returns(uint256);function transfer(address recipient,uint256 amount)external returns(bool);}contract LunchboxFeeSplitter{address public immutable creator;address public immutable operator;address public immutable protocol;IPonsV2FeeEscrow public immutable feeEscrow;uint16 public constant CREATOR_BPS=7000;uint16 public constant OPERATOR_BPS=2000;uint16 public constant PROTOCOL_BPS=1000;mapping(address=>uint256)public pending;mapping(address=>mapping(address=>uint256))public pendingToken;event FeesReceived(uint256 amount,uint256 creatorAmount,uint256 operatorAmount,uint256 protocolAmount);event TokenFeesReceived(address indexed token,uint256 amount,uint256 creatorAmount,uint256 operatorAmount,uint256 protocolAmount);event Withdrawn(address indexed recipient,uint256 amount);event TokenWithdrawn(address indexed token,address indexed recipient,uint256 amount);error InvalidRecipient();error NothingToWithdraw();error TransferFailed();constructor(address creator_,address operator_,address protocol_,address feeEscrow_){if(creator_==address(0)||operator_==address(0)||protocol_==address(0)||feeEscrow_==address(0))revert InvalidRecipient();creator=creator_;operator=operator_;protocol=protocol_;feeEscrow=IPonsV2FeeEscrow(feeEscrow_);}receive()external payable{_creditNative(msg.value);}function syncNative()external{feeEscrow.claim();}function syncToken(address token)external{uint256 beforeBalance=IERC20Minimal(token).balanceOf(address(this));feeEscrow.claimToken(token);uint256 amount=IERC20Minimal(token).balanceOf(address(this))-beforeBalance;if(amount>0)_creditToken(token,amount);}function withdraw()external{uint256 amount=pending[msg.sender];if(amount==0)revert NothingToWithdraw();pending[msg.sender]=0;(bool ok,)=payable(msg.sender).call{value:amount}("");if(!ok){pending[msg.sender]=amount;revert TransferFailed();}emit Withdrawn(msg.sender,amount);}function withdrawToken(address token)external{uint256 amount=pendingToken[token][msg.sender];if(amount==0)revert NothingToWithdraw();pendingToken[token][msg.sender]=0;if(!IERC20Minimal(token).transfer(msg.sender,amount)){pendingToken[token][msg.sender]=amount;revert TransferFailed();}emit TokenWithdrawn(token,msg.sender,amount);}function _creditNative(uint256 amount)private{uint256 c=(amount*CREATOR_BPS)/10000;uint256 o=(amount*OPERATOR_BPS)/10000;uint256 p=amount-c-o;pending[creator]+=c;pending[operator]+=o;pending[protocol]+=p;emit FeesReceived(amount,c,o,p);}function _creditToken(address token,uint256 amount)private{uint256 c=(amount*CREATOR_BPS)/10000;uint256 o=(amount*OPERATOR_BPS)/10000;uint256 p=amount-c-o;pendingToken[token][creator]+=c;pendingToken[token][operator]+=o;pendingToken[token][protocol]+=p;emit TokenFeesReceived(token,amount,c,o,p);}}

