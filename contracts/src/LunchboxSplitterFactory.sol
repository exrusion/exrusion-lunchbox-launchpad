pragma solidity ^0.8.24;
import{LunchboxFeeSplitter}from"./LunchboxFeeSplitter.sol";contract LunchboxSplitterFactory{address public immutable protocolTreasury;address public immutable feeEscrow;mapping(bytes32=>address)public splitterForLaunch;event SplitterCreated(bytes32 indexed launchId,address indexed splitter,address indexed creator,address operator);error InvalidInput();error AlreadyCreated();constructor(address treasury,address escrow){if(treasury==address(0)||escrow==address(0))revert InvalidInput();protocolTreasury=treasury;feeEscrow=escrow;}function createSplitter(bytes32 launchId,address creator,address operator)external returns(address splitter){if(launchId==bytes32(0)||creator==address(0)||operator==address(0))revert InvalidInput();if(splitterForLaunch[launchId]!=address(0))revert AlreadyCreated();bytes32 salt=keccak256(abi.encode(launchId,creator,operator));splitter=address(new LunchboxFeeSplitter{salt:salt}(creator,operator,protocolTreasury,feeEscrow));splitterForLaunch[launchId]=splitter;emit SplitterCreated(launchId,splitter,creator,operator);}function predictSplitter(bytes32 launchId,address creator,address operator)external view returns(address){bytes32 salt=keccak256(abi.encode(launchId,creator,operator));bytes memory code=abi.encodePacked(type(LunchboxFeeSplitter).creationCode,abi.encode(creator,operator,protocolTreasury,feeEscrow));bytes32 hash=keccak256(abi.encodePacked(bytes1(0xff),address(this),salt,keccak256(code)));return address(uint160(uint256(hash)));}}
