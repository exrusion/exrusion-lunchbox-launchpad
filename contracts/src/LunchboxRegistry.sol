pragma solidity ^0.8.24;
contract LunchboxRegistry {struct Pad{address owner;string slug;string metadataURI;bool active;}address public owner;mapping(bytes32=>Pad)private pads;mapping(bytes32=>bool)private usedSlugs;event PadRegistered(bytes32 indexed padId,address indexed padOwner,string slug,string metadataURI);event PadUpdated(bytes32 indexed padId,string metadataURI,bool active);event OwnershipTransferred(address indexed previousOwner,address indexed newOwner);error Unauthorized();error InvalidInput();error SlugTaken();constructor(address initialOwner){if(initialOwner==address(0))revert InvalidInput();owner=initialOwner;emit OwnershipTransferred(address(0),initialOwner);}modifier onlyOwner(){if(msg.sender!=owner)revert Unauthorized();_;}function registerPad(bytes32 padId,address padOwner,string calldata slug,string calldata metadataURI)external{if(msg.sender!=padOwner&&msg.sender!=owner)revert Unauthorized();if(padId==bytes32(0)||padOwner==address(0)||bytes(slug).length<3)revert InvalidInput();bytes32 slugHash=keccak256(bytes(slug));if(usedSlugs[slugHash]||pads[padId].owner!=address(0))revert SlugTaken();usedSlugs[slugHash]=true;pads[padId]=Pad(padOwner,slug,metadataURI,true);emit PadRegistered(padId,padOwner,slug,metadataURI);}function updatePad(bytes32 padId,string calldata metadataURI,bool active)external{Pad storage p=pads[padId];if(msg.sender!=p.owner&&msg.sender!=owner)revert Unauthorized();p.metadataURI=metadataURI;p.active=active;emit PadUpdated(padId,metadataURI,active);}function getPad(bytes32 padId)external view returns(Pad memory){return pads[padId];}function transferOwnership(address next)external onlyOwner{if(next==address(0))revert InvalidInput();emit OwnershipTransferred(owner,next);owner=next;}}

